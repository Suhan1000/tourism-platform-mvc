@model IEnumerable<TourismPlatform.Models.Tour>
@{
    ViewData["Title"] = "Tours";
    var canCreateTours = ViewBag.UserHasAgency ?? false;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Tours</h2>
        @if (canCreateTours)
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Tour
            </a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <!-- Tour Image -->
                        <img src="@(!string.IsNullOrEmpty(item.ImagePath) ? Url.Content(item.ImagePath) : "/images/default-tour.jpg")"
                             class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted mb-1"><strong>Destination:</strong> @item.Destination</p>
                            <p class="card-text text-muted mb-1"><strong>Duration:</strong> @item.Duration days</p>
                            <p class="card-text text-muted mb-3"><strong>Price:</strong> $@item.Price</p>

                            <div class="mt-auto d-flex justify-content-between flex-wrap gap-2">
                                @if (!canCreateTours)
                                {
                                    <a asp-controller="Bookings" asp-action="Create" asp-route-tourId="@item.Id" class="btn btn-sm btn-success w-100">
                                        Book Now
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info w-100">Details</a>
                                @if (canCreateTours)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning w-100">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger w-100">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-map text-muted" style="font-size: 4rem;"></i>
            <h4 class="text-muted">No tours available</h4>
            @if (canCreateTours)
            {
                <p class="text-muted">Create your first tour to get started!</p>
                <a asp-action="Create" class="btn btn-success">Create Your First Tour</a>
            }
            else
            {
                <p class="text-muted">Check back later for new adventures!</p>
            }
        </div>
    }
</div>
