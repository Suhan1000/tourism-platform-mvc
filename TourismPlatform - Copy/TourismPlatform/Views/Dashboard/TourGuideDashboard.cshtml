@model TourismPlatform.Models.Agency
@{
    ViewData["Title"] = "Tour Guide Dashboard";
}

<!-- Header Section -->
<div class="bg-success text-white py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2><i class="bi bi-person-badge"></i> @Model.AgencyName</h2>
                <p class="mb-0">Tour Guide Dashboard - Manage your personal tours</p>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-light text-dark fs-6">
                    <i class="bi bi-award"></i> Individual Guide
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        
        <!-- Personal Stats -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-success h-100">
                <div class="card-body text-center">
                    <i class="bi bi-map text-success" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">@Model.Tours.Count</h4>
                    <p class="text-muted mb-0">My Tours</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people text-primary" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">@(Model.Tours.Sum(t => t.Bookings?.Count ?? 0))</h4>
                    <p class="text-muted mb-0">Total Bookings</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-warning h-100">
                <div class="card-body text-center">
                    <i class="bi bi-star text-warning" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">4.8</h4>
                    <p class="text-muted mb-0">Average Rating</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-info h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bar-chart text-info" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">@Model.MaxToursAllowed</h4>
                    <p class="text-muted mb-0">Tour Limit</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tour Limit Warning -->
    @if (Model.Tours.Count >= Model.MaxToursAllowed * 0.8)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Tour Limit Notice:</strong> You have @Model.Tours.Count out of @Model.MaxToursAllowed tours. 
                    @if (Model.Tours.Count >= Model.MaxToursAllowed)
                    {
                        <span>You've reached your tour limit. Contact support to upgrade.</span>
                    }
                    else
                    {
                        <span>You're approaching your tour limit.</span>
                    }
                </div>
            </div>
        </div>
    }
    
    <!-- Quick Actions for Tour Guide -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <button class="btn btn-success w-100" disabled title="Coming soon in future updates">
                                <i class="bi bi-check2-square"></i> Apply for Guide
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100" disabled title="Coming soon in future updates">
                                <i class="bi bi-clock-history"></i> My Guide History
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-info w-100" disabled title="Coming soon in future updates">
                                <i class="bi bi-person-gear"></i> Update Profile
                            </button>
                        </div>
                    </div>
                    <p class="text-muted mt-2">All features above will be available in future updates.</p>
                </div>
            </div>
        </div>
    </div>
    
   