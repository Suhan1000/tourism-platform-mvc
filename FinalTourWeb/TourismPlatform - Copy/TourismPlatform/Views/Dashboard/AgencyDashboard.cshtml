@model TourismPlatform.Models.Agency
@{
    ViewData["Title"] = "Agency Dashboard";
}

<!-- Header Section -->
<div class="bg-primary text-white py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2><i class="bi bi-building"></i> @Model.AgencyName</h2>
                <p class="mb-0">Travel Agency Dashboard - Manage your business</p>
            </div>
            <div class="col-md-4 text-end">
                <span class="badge bg-light text-dark fs-6">
                    <i class="bi bi-star"></i> Premium Account
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">

        <!-- Business Overview Cards -->
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-primary h-100">
                <div class="card-body text-center">
                    <i class="bi bi-map text-primary" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">@Model.Tours.Count</h4>
                    <p class="text-muted mb-0">Active Tours</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-success h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people text-success" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">@(Model.Tours.Sum(t => t.Bookings?.Count ?? 0))</h4>
                    <p class="text-muted mb-0">Total Bookings</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-warning h-100">
                <div class="card-body text-center">
                    <i class="bi bi-cash text-warning" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">$@(Model.Tours.Sum(t => (t.Bookings?.Sum(b => b.TotalAmount) ?? 0)).ToString("N0"))</h4>
                    <p class="text-muted mb-0">Total Revenue</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-info h-100">
                <div class="card-body text-center">
                    <i class="bi bi-infinity text-info" style="font-size: 2.5rem;"></i>
                    <h4 class="mt-2">Unlimited</h4>
                    <p class="text-muted mb-0">Tour Limit</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a href="@Url.Action("Create", "Tours")" class="btn btn-success w-100">
                                <i class="bi bi-plus-circle"></i> Create New Tour
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="@Url.Action("Index", "Tours")" class="btn btn-primary w-100">
                                <i class="bi bi-list"></i> Manage Tours
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="#" class="btn btn-info w-100" data-bs-toggle="modal" data-bs-target="#comingSoonModal">
                                <i class="bi bi-people"></i> Team Management
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="#" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#comingSoonModal">
                                <i class="bi bi-graph-up"></i> Analytics
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Tours -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-map"></i> Your Recent Tours</h5>
                </div>
                <div class="card-body">
                    @if (Model.Tours.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Tour Name</th>
                                        <th>Price</th>
                                        <th>Duration</th>
                                        <th>Bookings</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tour in Model.Tours.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@tour.Name</strong><br>
                                                <small class="text-muted">@tour.Destination</small>
                                            </td>
                                            <td>$@tour.Price</td>
                                            <td>@tour.Duration days</td>
                                            <td>
                                                <span class="badge bg-primary">@(tour.Bookings?.Count ?? 0) bookings</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Tours", new { id = tour.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="@Url.Action("Details", "Tours", new { id = tour.Id })" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Tours")" class="btn btn-primary">
                                <i class="bi bi-arrow-right"></i> View All Tours
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-map text-muted" style="font-size: 4rem;"></i>
                            <h4 class="text-muted mt-3">No tours yet</h4>
                            <p class="text-muted">Create your first tour to get started!</p>
                            <a href="@Url.Action("Create", "Tours")" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Create Your First Tour
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Coming Soon Modal -->
<div class="modal fade" id="comingSoonModal" tabindex="-1" aria-labelledby="comingSoonLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="comingSoonLabel"><i class="bi bi-exclamation-circle"></i> Coming Soon!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-0">This feature will be available in a future update. Stay tuned!</p>
                <i class="bi bi-clock-history" style="font-size: 3rem;"></i>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>