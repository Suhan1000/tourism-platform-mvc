@model List<TourismPlatform.Models.Booking>

<h2>My Feedback</h2>

@if (!Model.Any())
{
    <p>You have no completed bookings yet.</p>
}
else
{
    <div class="row">
        @foreach (var booking in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@booking.Tour.Name</h5>
                        <p class="card-text">@booking.Tour.Destination</p>

                        @if (booking.Feedback != null)
                        {
                            <p><strong>Your Rating:</strong> @booking.Feedback.Rating / 5</p>
                            <p><strong>Comments:</strong> @booking.Feedback.Comments</p>
                        }
                        else
                        {
                            <form asp-action="GiveFeedback" method="post">
                                <input type="hidden" name="bookingId" value="@booking.Id" />
                                <div class="mb-2">
                                    <label>Rating (1-5)</label>
                                    <input type="number" name="rating" min="1" max="5" class="form-control" required />
                                </div>
                                <div class="mb-2">
                                    <label>Comments</label>
                                    <textarea name="comments" class="form-control" rows="2"></textarea>
                                </div>
                                <button type="submit" class="btn btn-success">Submit Feedback</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

